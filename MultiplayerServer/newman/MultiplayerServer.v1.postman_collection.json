  "item": [
    {
      "name": "Smoke",
      "item": [
        {
          "name": "GET /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const payload = pm.response.json();",
                  "pm.expect(payload.status).to.eql('ok');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "response": []
        },
        {
          "name": "GET /api/v1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const payload = pm.response.json();",
                  "pm.expect(payload.service).to.eql('MultiplayerServer');",
                  "pm.expect(payload.version).to.eql('v1');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Match Flow",
      "item": [
        {
          "name": "POST /api/v1/matches (Create Match)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const payload = pm.response.json();",
                  "pm.expect(payload).to.have.property('matchId');",
                  "pm.expect(payload).to.have.property('joinCode');",
                  "pm.expect(payload).to.have.property('creatorToken');",
                  "",
                  "pm.collectionVariables.set('matchId', payload.matchId);",
                  "pm.collectionVariables.set('joinCode', payload.joinCode);",
                  "pm.collectionVariables.set('creatorToken', payload.creatorToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/matches"
          },
          "response": []
        },
        {
          "name": "POST /api/v1/matches/join (Join Match)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const payload = pm.response.json();",
                  "pm.expect(payload.matchId).to.eql(pm.collectionVariables.get('matchId'));",
                  "pm.expect(payload.seat).to.eql('Black');",
                  "pm.expect(payload).to.have.property('playerToken');",
                  "",
                  "pm.collectionVariables.set('joinerToken', payload.playerToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"joinCode\": \"{{joinCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/matches/join"
          },
          "response": []
        },
        {
          "name": "POST /api/v1/matches/moves (White Move)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const payload = pm.response.json();",
                  "pm.expect(payload.accepted).to.eql(true);",
                  "pm.expect(payload.snapshot.matchId).to.eql(pm.collectionVariables.get('matchId'));",
                  "pm.expect(payload.snapshot.sideToMove).to.eql('Black');",
                  "pm.collectionVariables.set('lastMoveNumber', String(payload.snapshot.moveNumber));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"matchId\": \"{{matchId}}\",\n  \"playerToken\": \"{{creatorToken}}\",\n  \"from\": \"{{whiteFrom}}\",\n  \"to\": \"{{whiteTo}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/matches/moves"
          },
          "response": []
        },
        {
          "name": "POST /api/v1/matches/moves (Black Move)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const payload = pm.response.json();",
                  "pm.expect(payload.accepted).to.eql(true);",
                  "pm.expect(payload.snapshot.matchId).to.eql(pm.collectionVariables.get('matchId'));",
                  "pm.expect(payload.snapshot.sideToMove).to.eql('White');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"matchId\": \"{{matchId}}\",\n  \"playerToken\": \"{{joinerToken}}\",\n  \"from\": \"{{blackFrom}}\",\n  \"to\": \"{{blackTo}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/matches/moves"
          },
          "response": []
        }
      ]
    },
