<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Chess.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="920" d:DesignHeight="760"
        x:Class="Chess.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}">
    <Grid Margin="20"
          RowDefinitions="Auto,Auto,*"
          ColumnDefinitions="*,Auto"
          RowSpacing="14"
          ColumnSpacing="16">
        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Text="Chess"
                   FontSize="28"
                   FontWeight="Bold" />

        <Button Grid.Row="0"
                Grid.Column="1"
                Content="Start New Game"
                Command="{Binding NewGameCommand}"
                MinWidth="150"
                HorizontalAlignment="Right" />

        <StackPanel Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Spacing="4">
            <TextBlock x:Name="GameStatusTextBlock"
                       Text="{Binding GameStatusText}"
                       FontSize="17"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="LastActionTextBlock"
                       Text="{Binding LastActionText}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="FeedbackTextBlock"
                       Text="{Binding FeedbackText}"
                       TextWrapping="Wrap"
                       Foreground="#B03030"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="FocusedSquareTextBlock"
                       Text="{Binding FocusedSquareText}"
                       FontWeight="SemiBold"
                       FontSize="13" />
            <TextBlock x:Name="KeyboardHintTextBlock"
                       Text="{Binding KeyboardHintText}"
                       TextWrapping="Wrap"
                       Opacity="0.85"
                       FontSize="12" />
        </StackPanel>

        <Border Grid.Row="2"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Padding="0">
            <Viewbox Stretch="Uniform"
                     StretchDirection="Both"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top">
                <Grid Width="736"
                      Height="736"
                      UseLayoutRounding="True"
                      RowDefinitions="*,40"
                      ColumnDefinitions="40,*"
                      RowSpacing="0"
                      ColumnSpacing="0">
                    <ItemsControl x:Name="RankCoordinatesItemsControl"
                                  Grid.Row="0"
                                  Grid.Column="0"
                                  ItemsSource="{Binding RankCoordinates}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="8" Columns="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding .}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#4A3322"
                                           Opacity="0.85" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Grid.Row="0"
                            Grid.Column="1"
                            BorderBrush="#2C2C2C"
                            BorderThickness="2"
                            CornerRadius="0"
                            Padding="0"
                            ClipToBounds="True">
                        <ItemsControl x:Name="BoardItemsControl"
                                      ItemsSource="{Binding BoardSquares}"
                                      UseLayoutRounding="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="8" Columns="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BoardSquareViewModel">
                                    <Button Command="{Binding ClickCommand}"
                                            Classes="board-square"
                                            Tag="{Binding CoordinateLabel}"
                                            Background="{Binding Background}"
                                            BorderBrush="{Binding BorderBrush}"
                                            BorderThickness="{Binding BorderThickness}"
                                            ToolTip.Tip="{Binding SquareDescription}"
                                            CornerRadius="0"
                                            Padding="0"
                                            Margin="0"
                                            MinWidth="0"
                                            MinHeight="0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center">
                                        <TextBlock Text="{Binding PieceGlyph}"
                                                   FontSize="46"
                                                   FontFamily="Inter, Segoe UI Symbol, Noto Sans Symbols2, DejaVu Sans"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <ItemsControl x:Name="FileCoordinatesItemsControl"
                                  Grid.Row="1"
                                  Grid.Column="1"
                                  ItemsSource="{Binding FileCoordinates}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding .}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#4A3322"
                                           Opacity="0.85" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Viewbox>
        </Border>
    </Grid>
</Window>
