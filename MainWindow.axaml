<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Chess.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="920" d:DesignHeight="760"
        x:Class="Chess.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}">
    <Window.Styles>
        <Style Selector="Button.board-square">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="SquareChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.board-square:pointerover /template/ Border#SquareChrome">
            <Setter Property="Background" Value="#CC9E9E9E" />
        </Style>
        <Style Selector="Button.board-square:pressed /template/ Border#SquareChrome">
            <Setter Property="Background" Value="#E08B8B8B" />
        </Style>
    </Window.Styles>
    <Grid Margin="20"
          RowDefinitions="Auto,*"
          RowSpacing="14">
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="16">
            <TextBlock Grid.Column="0"
                   Text="Chess"
                   FontSize="28"
                   FontWeight="Bold" />

            <Button Grid.Column="1"
                    Content="Start New Game"
                    Command="{Binding NewGameCommand}"
                    MinWidth="150"
                    HorizontalAlignment="Right" />
        </Grid>

        <Grid x:Name="MainContentGrid"
              Grid.Row="1"
              RowDefinitions="*"
              ColumnDefinitions="*,300"
              RowSpacing="0"
              ColumnSpacing="16">
            <Border x:Name="BoardContainerBorder"
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Padding="0">
                <Viewbox Stretch="Uniform"
                         StretchDirection="Both"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top">
                    <Grid Width="736"
                          Height="736"
                          UseLayoutRounding="True"
                          RowDefinitions="*,40"
                          ColumnDefinitions="40,*"
                          RowSpacing="0"
                          ColumnSpacing="0">
                        <ItemsControl x:Name="RankCoordinatesItemsControl"
                                      Grid.Row="0"
                                      Grid.Column="0"
                                      ItemsSource="{Binding RankCoordinates}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="8" Columns="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding .}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="#4A3322"
                                               Opacity="0.85" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Grid.Row="0"
                                Grid.Column="1"
                                BorderBrush="#2C2C2C"
                                BorderThickness="2"
                                CornerRadius="0"
                                Padding="0"
                                ClipToBounds="True">
                            <ItemsControl x:Name="BoardItemsControl"
                                          ItemsSource="{Binding BoardSquares}"
                                          UseLayoutRounding="True">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="8" Columns="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BoardSquareViewModel">
                                        <Button Command="{Binding ClickCommand}"
                                                Classes="board-square"
                                                Tag="{Binding CoordinateLabel}"
                                                Background="{Binding Background}"
                                                BorderBrush="{Binding BorderBrush}"
                                                BorderThickness="{Binding BorderThickness}"
                                                ToolTip.Tip="{Binding SquareDescription}"
                                                CornerRadius="0"
                                                Padding="0"
                                                Margin="0"
                                                MinWidth="0"
                                                MinHeight="0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center">
                                            <Grid>
                                                <Image Source="{Binding PieceImage}"
                                                       Stretch="Uniform"
                                                       Width="64"
                                                       Height="64"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                                <Ellipse HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Width="{Binding LegalDestinationIndicatorDiameter}"
                                                         Height="{Binding LegalDestinationIndicatorDiameter}"
                                                         Fill="{Binding LegalDestinationIndicatorBrush}"
                                                         Opacity="{Binding LegalDestinationIndicatorOpacity}"
                                                         IsVisible="{Binding IsLegalDestinationIndicatorVisible}"
                                                         IsHitTestVisible="False"
                                                         ZIndex="1" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <ItemsControl x:Name="FileCoordinatesItemsControl"
                                      Grid.Row="1"
                                      Grid.Column="1"
                                      ItemsSource="{Binding FileCoordinates}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding .}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="#4A3322"
                                               Opacity="0.85" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Viewbox>
            </Border>

            <Border x:Name="SidePanelBorder"
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="300"
                    MinWidth="260"
                    MaxWidth="340"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    BorderBrush="#D5C7B7"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*"
                      RowSpacing="10">
                    <TextBlock Grid.Row="0"
                               Text="Game Panel"
                               FontSize="18"
                               FontWeight="SemiBold" />

                    <StackPanel Grid.Row="1"
                                Spacing="6">
                        <TextBlock x:Name="GameStatusTextBlock"
                                   Text="{Binding GameStatusText}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="LastActionTextBlock"
                                   Text="{Binding LastActionText}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="FeedbackTextBlock"
                                   Text="{Binding FeedbackText}"
                                   TextWrapping="Wrap"
                                   Foreground="#B03030"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Spacing="4">
                        <TextBlock x:Name="FocusedSquareTextBlock"
                                   Text="{Binding FocusedSquareText}"
                                   FontWeight="SemiBold"
                                   FontSize="13" />
                        <TextBlock x:Name="KeyboardHintTextBlock"
                                   Text="{Binding KeyboardHintText}"
                                   TextWrapping="Wrap"
                                   Opacity="0.85"
                                   FontSize="12" />
                        <CheckBox x:Name="ShowLegalMoveSuggestionsCheckBox"
                                  Content="Show legal move suggestions"
                                  IsChecked="{Binding ShowLegalMoveSuggestions}" />
                    </StackPanel>

                    <StackPanel Grid.Row="3"
                                Spacing="6">
                        <CheckBox x:Name="PlayVsAiCheckBox"
                                  Content="Play vs AI"
                                  IsEnabled="{Binding IsAiAvailable}"
                                  IsChecked="{Binding IsPlayVsAiEnabled}" />
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="8">
                            <TextBlock VerticalAlignment="Center"
                                       Text="AI Side:" />
                            <ComboBox x:Name="AiSideComboBox"
                                      Grid.Column="1"
                                      ItemsSource="{Binding AvailableAiColors}"
                                      IsEnabled="{Binding IsPlayVsAiEnabled}"
                                      SelectedItem="{Binding AiControlledColor}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="8">
                            <TextBlock VerticalAlignment="Center"
                                       Text="Depth:" />
                            <ComboBox x:Name="AiDepthComboBox"
                                      Grid.Column="1"
                                      ItemsSource="{Binding AvailableAiSearchDepths}"
                                      IsEnabled="{Binding IsPlayVsAiEnabled}"
                                      SelectedItem="{Binding AiSearchDepth}" />
                        </Grid>
                        <TextBlock x:Name="AiThinkingTextBlock"
                                   Text="AI is thinking..."
                                   IsVisible="{Binding IsAiThinking}"
                                   FontStyle="Italic"
                                   Opacity="0.85" />
                    </StackPanel>

                    <StackPanel Grid.Row="4"
                                Spacing="6">
                        <TextBlock Text="Save File"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="SaveFilePathTextBox"
                                 Text="{Binding PersistenceFilePath}"
                                 Watermark="Path to save file"
                                 MinWidth="220" />
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="8">
                            <Button x:Name="SaveGameButton"
                                    Grid.Column="0"
                                    Content="Save Game"
                                    Command="{Binding SaveGameCommand}" />
                            <Button x:Name="LoadGameButton"
                                    Grid.Column="1"
                                    Content="Load Game"
                                    Command="{Binding LoadGameCommand}" />
                        </Grid>
                    </StackPanel>

                    <TextBlock Grid.Row="5"
                               Text="Move History"
                               FontSize="16"
                               FontWeight="SemiBold" />

                    <Border Grid.Row="6"
                            BorderBrush="#D5C7B7"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8"
                            MinHeight="180">
                        <ScrollViewer x:Name="MoveHistoryScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="MoveHistoryEmptyTextBlock"
                                           Text="No moves yet."
                                           IsVisible="{Binding IsMoveHistoryEmpty}"
                                           Opacity="0.8"
                                           FontStyle="Italic" />
                                <ItemsControl x:Name="MoveHistoryItemsControl"
                                              ItemsSource="{Binding MoveHistoryEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MoveHistoryEntryViewModel">
                                            <Grid ColumnDefinitions="Auto,Auto,*"
                                                  ColumnSpacing="8">
                                                <TextBlock Classes="move-history-prefix"
                                                           Grid.Column="0"
                                                           Text="{Binding MovePrefix}"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           FontFamily="Consolas, Menlo, monospace" />
                                                <Border Classes="move-history-piece-icon"
                                                        Grid.Column="1"
                                                        Width="24"
                                                        Height="24"
                                                        CornerRadius="4"
                                                        BorderThickness="1"
                                                        BorderBrush="{Binding SideBorderBrush}"
                                                        Background="{Binding SideColorBrush}"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center">
                                                    <Grid>
                                                        <Image Source="{Binding PieceIconImage}"
                                                               Stretch="Uniform"
                                                               Width="16"
                                                               Height="16"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock Classes="move-history-notation"
                                                           Grid.Column="2"
                                                           Text="{Binding Notation}"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           FontFamily="Consolas, Menlo, monospace" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
